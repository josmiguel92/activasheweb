---
import { SEO } from "astro-seo";
import { SITE_URL } from "@/data/config";
import presentation from "@/data/presentation";
import imageSize from "@/utils/imageSize";

type Props = {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Imagen de la tarjeta social (ruta de public/ o URL absoluta). */
  image?: string;
  /** Texto alternativo de la imagen social; por defecto, el título. */
  imageAlt?: string;
  /** "article" para posts/proyectos/obras; "website" para el resto. */
  type?: "website" | "article";
  publishedAt?: Date;
  modifiedAt?: Date;
  section?: string;
  tags?: string[];
  author?: string;
  keywords?: string[];
};

const {
  title,
  description,
  noindex,
  image,
  imageAlt,
  type = "website",
  publishedAt,
  modifiedAt,
  section,
  tags,
  author,
  keywords = [],
} = Astro.props;

const toAbsoluteUrl = (maybeUrl?: string) => {
  if (!maybeUrl) return undefined;
  if (maybeUrl.startsWith("http://") || maybeUrl.startsWith("https://")) return maybeUrl;
  const leadingSlash = maybeUrl.startsWith("/") ? "" : "/";
  return `${SITE_URL}${leadingSlash}${maybeUrl}`;
};

const DEFAULT_TITLE_PAGE = "ActivaShe | Visibilidad y Apoyo Afrodescendiente";
const DEFAULT_DESCRIPTION_PAGE =
  "ActivaShe: Visibilidad y apoyo a mujeres afrodescendientes en vulnerabilidad, promoviendo equidad y derechos humanos.";
const DEFAULT_IMAGE_PATH = "/opengraph-image.jpg";
const DEFAULT_IMAGE_ALT = "Logo de ActivaShe con el eslogan 'Visibilidad y Equidad'";
const DEFAULT_SITE_NAME = "ActivaShe";
const DEFAULT_LOCALE = "es_ES";
const DEFAULT_AUTHOR = "ActivaShe";
const DEFAULT_KEYWORDS = [
  "ActivaShe",
  "mujeres afrodescendientes",
  "equidad",
  "justicia social",
  "comunidad",
];

const pageTitle = title || DEFAULT_TITLE_PAGE;
const pageDescription = description || DEFAULT_DESCRIPTION_PAGE;
const imagePath = image || DEFAULT_IMAGE_PATH;
const imageUrl = toAbsoluteUrl(imagePath)!;
const size = imageSize(imagePath);
const alt = image ? imageAlt || pageTitle : DEFAULT_IMAGE_ALT;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;

const jsonLd: Record<string, unknown>[] = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: DEFAULT_SITE_NAME,
    url: SITE_URL,
    logo: toAbsoluteUrl(DEFAULT_IMAGE_PATH),
    description: DEFAULT_DESCRIPTION_PAGE,
    sameAs: presentation.socials?.map((s) => s.link).filter(Boolean) || [],
  },
];

if (type === "article") {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: pageTitle,
    description: pageDescription,
    image: imageUrl,
    url: canonical,
    datePublished: publishedAt?.toISOString(),
    dateModified: (modifiedAt ?? publishedAt)?.toISOString(),
    author: { "@type": "Organization", name: author || DEFAULT_AUTHOR },
    publisher: {
      "@type": "Organization",
      name: DEFAULT_SITE_NAME,
      logo: { "@type": "ImageObject", url: toAbsoluteUrl(DEFAULT_IMAGE_PATH) },
    },
    articleSection: section,
    keywords: tags?.join(", "),
    inLanguage: "es",
  });
}
---

<SEO
  charset="UTF-8"
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  noindex={noindex || false}
  openGraph={{
    basic: {
      title: pageTitle,
      type,
      image: imageUrl,
      url: canonical,
    },
    optional: {
      description: pageDescription,
      siteName: DEFAULT_SITE_NAME,
      locale: DEFAULT_LOCALE,
    },
    image: {
      alt,
      width: size?.width,
      // astro-seo solo omite la etiqueta si el valor es null (undefined deja un content vacío)
      height: (size?.height ?? null) as any,
    },
    ...(type === "article"
      ? {
          article: {
            publishedTime: publishedAt?.toISOString(),
            modifiedTime: modifiedAt?.toISOString(),
            authors: [author || DEFAULT_AUTHOR],
            section,
            tags,
          },
        }
      : {}),
  }}
  twitter={{
    card: "summary_large_image",
    site: "@activashecuba",
    creator: "@activashecuba",
    title: pageTitle,
    description: pageDescription,
    image: imageUrl,
    imageAlt: alt,
  }}
  extend={{
    link: [
      { rel: "icon", href: "/favicon.png" },
      { rel: "sitemap", href: "/sitemap-index.xml" },
    ],
    meta: [
      { name: "viewport", content: "width=device-width, initial-scale=1" },
      { name: "theme-color", content: "#2D1B14" },
      { name: "generator", content: Astro.generator },
      { name: "author", content: author || DEFAULT_AUTHOR },
      { name: "keywords", content: (keywords.length ? keywords : DEFAULT_KEYWORDS).join(", ") },
    ],
    scripts: jsonLd.map((data) => ({
      type: "application/ld+json",
      children: JSON.stringify(data),
    })),
  }}
/>
