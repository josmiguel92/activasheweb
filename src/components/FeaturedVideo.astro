---
import { fechaISO } from "@/utils/formatDate";

interface Props {
  featuredVideo: any;
}

const { featuredVideo } = Astro.props;
const backgroundImage = `https://img.youtube.com/vi/${featuredVideo.data.youtubeId}/maxresdefault.jpg`;
const embedUrl = `https://www.youtube.com/embed/${featuredVideo.data.youtubeId}?rel=0&showinfo=0&modestbranding=1&controls=1`;
const playerId = `featured-video-${
  featuredVideo.id ?? featuredVideo.slug ?? featuredVideo.data.youtubeId
}`;

/** «1:05» y «1:02:30» en la notación ISO 8601 que espera schema.org. */
function duracionISO(duracion?: string) {
  if (!duracion) return undefined;
  const partes = duracion.split(":").map(Number);
  if (partes.some(Number.isNaN)) return undefined;
  const [horas, minutos, segundos] =
    partes.length === 3 ? partes : [0, partes[0] ?? 0, partes[1] ?? 0];
  return `PT${horas ? `${horas}H` : ""}${minutos ? `${minutos}M` : ""}${segundos}S`;
}

// Ficha del vídeo para los buscadores. Google puede enseñar la miniatura y un
// enlace al vídeo en los resultados cuando el vídeo está incrustado en la
// página, como aquí.
const fichaDelVideo = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: featuredVideo.data.title,
  description: featuredVideo.data.description || featuredVideo.data.title,
  thumbnailUrl: [backgroundImage],
  uploadDate: fechaISO(featuredVideo.data.publishedAt),
  duration: duracionISO(featuredVideo.data.duration),
  embedUrl: `https://www.youtube.com/embed/${featuredVideo.data.youtubeId}`,
  contentUrl: `https://www.youtube.com/watch?v=${featuredVideo.data.youtubeId}`,
  inLanguage: "es",
};
---

<script type="application/ld+json" set:html={JSON.stringify(fichaDelVideo)} />

<div class="mb-6">
  <p class="mb-2 text-sm font-bold uppercase tracking-widest text-terracotta">
    Destacado
  </p>
  <div
    class="card-shadow relative overflow-hidden rounded-2xl border border-terracotta/40 bg-chocolate"
    id={playerId}
  >
    <div
      class="aspect-video bg-cover bg-center"
      style={`background-image: url('${backgroundImage}');`}
    >
      <iframe
        class="h-full w-full"
        src={embedUrl}
        title={featuredVideo.data.title}
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        allowfullscreen></iframe>
    </div>
    <div class="border-t border-terracotta/50 bg-chocolate/90 px-4 py-4">
      <h3 class="mb-2 text-lg font-bold text-warm-cream">
        {featuredVideo.data.title}
      </h3>
      <div
        class="flex items-center justify-between text-[11px] font-semibold uppercase tracking-widest"
      >
        <span class="text-mustard">{featuredVideo.data.category}</span>
        <span class="text-warm-cream/80">{featuredVideo.data.duration}</span>
      </div>
    </div>
  </div>
</div>
