---
import removeTrailingSlash from "@/utils/removeTrailingSlash";
import presentation from "@/data/presentation";

const pathname = removeTrailingSlash(Astro.url.pathname);

const navLinks = [
  {
    href: "/",
    label: "Inicio",
    isActive: (path: string) => path === "/" || path === "",
  },
  {
    href: "/about",
    label: "Quiénes Somos",
    isActive: (path: string) => path === "/about",
  },
  {
    href: "/posts",
    label: "Publicaciones",
    isActive: (path: string) => path.startsWith("/posts"),
  },
  {
    href: "/projects",
    label: "Proyectos",
    isActive: (path: string) => path.startsWith("/projects"),
  },
  {
    href: "/gallery",
    label: "Galería",
    isActive: (path: string) => path.startsWith("/gallery"),
  },
  {
    href: "/podcasts",
    label: "Podcasts",
    isActive: (path: string) => path.startsWith("/podcasts"),
  },
  {
    href: "/donate",
    label: "Donar",
    isActive: (path: string) => path === "/donate",
  },
];

const isHome = pathname === "/" || pathname === "";
const visibleLinks = navLinks.filter((link) => !(isHome && link.href === "/"));
---

<nav
  aria-label="Navegación principal"
  class="sticky top-0 z-50 border-b border-white/10 bg-chocolate/80 px-6 py-4 shadow-lg backdrop-blur-xl backdrop-saturate-150"
>
  <div class="flex flex-wrap items-center gap-x-8 gap-y-4">
    <a
      href="/"
      class="order-1 rounded font-display text-xl font-bold uppercase tracking-widest text-mustard"
      aria-label="ActivaShe, ir al inicio"
      >ActivaShe</a
    >

    <div
      class="no-scrollbar order-3 flex w-full min-w-0 items-center gap-6 overflow-x-auto whitespace-nowrap pb-1 text-sm font-semibold md:order-2 md:w-auto md:flex-1 md:justify-center md:pb-0"
    >
      {
        visibleLinks.map((link) => (
          <a
            href={link.href}
            aria-current={link.isActive(pathname) ? "page" : undefined}
            class:list={{
              ["text-vibrant-orange"]: link.isActive(pathname),
              ["text-warm-cream/70 hover:text-vibrant-orange transition-colors"]:
                !link.isActive(pathname),
            }}
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="order-2 ml-auto flex flex-shrink-0 items-center gap-3 md:order-3">
      <a
        href={`mailto:${presentation.mail}`}
        class="rounded text-sm transition-colors hover:text-vibrant-orange"
        aria-label={`Escribir a ${presentation.mail}`}
      >
        <span class="material-symbols-outlined text-vibrant-orange" aria-hidden="true">mail</span>
      </a>

      <div class="relative md:hidden">
        <details class="group">
          <summary
            class="flex cursor-pointer list-none items-center gap-1 rounded-full border border-white/10 px-3 py-1 text-warm-cream/80 transition-colors hover:border-vibrant-orange hover:text-vibrant-orange"
          >
            <span class="material-symbols-outlined text-base" aria-hidden="true">more_horiz</span>
            <span class="text-xs font-semibold">Más</span>
          </summary>
          <div
            class="absolute right-0 mt-2 w-52 rounded-2xl border border-white/10 bg-chocolate/95 shadow-xl backdrop-blur-xl"
          >
            <ul class="py-2">
              {
                visibleLinks.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={link.isActive(pathname) ? "page" : undefined}
                      class:list={{
                        ["block px-4 py-2 text-sm font-semibold text-vibrant-orange"]:
                          link.isActive(pathname),
                        ["block px-4 py-2 text-sm font-semibold text-warm-cream/80 hover:text-vibrant-orange hover:bg-white/5 transition-colors"]:
                          !link.isActive(pathname),
                      }}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </details>
      </div>
    </div>
  </div>
</nav>
