---
import formatDate from "@/utils/formatDate";
import { fechaISO } from "@/utils/formatDate";

type Props = {
  title: string;
  publishedAt?: Date;
  description: string;
  slug: string;
  image?: string;
  readingTime?: number;
};

const { title, publishedAt, description, slug, image, readingTime } =
  Astro.props;
---

<article
  class="card-shadow overflow-hidden rounded-3xl border-t-4 border-terracotta bg-white/5 text-chocolate"
>
  {
    image && (
      <div class="relative h-48 overflow-hidden">
        <img
          src={image}
          alt={title}
          class="h-full w-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-chocolate/80 to-transparent" />
      </div>
    )
  }
  <div class="p-6">
    <div class="mb-4 flex items-center justify-between">
      <span
        class="text-[10px] font-black uppercase tracking-widest text-terracotta"
        >Publicación</span
      >
      <span class="text-[11px] font-medium text-chocolate/70">
        <time datetime={fechaISO(publishedAt)}>{formatDate(publishedAt)}</time>
        {readingTime && <span aria-hidden="true"> · </span>}
        {readingTime && <span>{readingTime} min de lectura</span>}
      </span>
    </div>
    <h3 class="mb-3 text-xl leading-snug text-terracotta">
      <a href={`/posts/${slug}`} class="hover:underline">
        {title}
      </a>
    </h3>
    <p class="mb-6 line-clamp-3 text-sm leading-relaxed text-chocolate/80">{description}</p>
    <a
      class="flex items-center gap-2 text-sm font-bold text-terracotta-deep transition-all hover:gap-3 hover:text-terracotta motion-reduce:transition-none"
      href={`/posts/${slug}`}
      aria-label={`Leer artículo completo: ${title}`}
    >
      Leer artículo completo
      <span class="material-symbols-outlined text-sm" aria-hidden="true">north_east</span>
    </a>
  </div>
</article>
