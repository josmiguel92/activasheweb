---
import { getEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import negritas from "@/utils/negritas";

// Los textos se editan desde /admin → «Páginas fijas → Quiénes somos».
const { data: pagina } = await getEntry("pages", "about");
---

<Layout title={pagina.title} description={pagina.seoDescription}>
  <section class="mx-auto max-w-4xl space-y-8 px-6 lg:max-w-6xl">
    <div
      class="card-shadow relative overflow-hidden rounded-3xl bg-terracotta p-8 md:p-12"
    >
      <div
        class="pattern-background pointer-events-none absolute inset-0 opacity-20"
      >
      </div>
      <div class="relative z-10">
        <h1 class="mb-6 font-display text-4xl text-warm-cream">
          {pagina.heading}{
            pagina.headingHighlight && (
              <>
                {" "}
                <span class="underline decoration-mustard decoration-4 underline-offset-4">
                  {pagina.headingHighlight}
                </span>
              </>
            )
          }
        </h1>

        {
          pagina.intro.length > 0 && (
            <div class="flex flex-col gap-6 leading-relaxed text-warm-cream/95">
              {pagina.intro.map((parrafo) => (
                <p class="text-lg" set:html={negritas(parrafo)} />
              ))}
            </div>
          )
        }
      </div>
    </div>

    {
      pagina.sections.map((seccion) => (
        <div>
          {seccion.heading && (
            <h2 class="mb-6 font-display text-3xl text-chocolate">
              {seccion.heading}
            </h2>
          )}
          {seccion.paragraphs.map((parrafo) => (
            <p class="text-lg" set:html={negritas(parrafo)} />
          ))}
          {seccion.cards.length > 0 && (
            <div class="mt-4 grid gap-4 md:grid-cols-2">
              {seccion.cards.map((tarjeta) => (
                <div class="rounded-2xl border-l-4 border-mustard bg-chocolate/10 p-6">
                  <div class="mb-3 flex items-center gap-3">
                    {/* set:text evita los saltos de línea alrededor del
                        nombre: la fuente Material Symbols solo forma el
                        icono si el texto va pegado a las etiquetas. */}
                    <span
                      class="material-symbols-outlined text-3xl text-mustard-deep"
                      aria-hidden="true"
                      set:text={tarjeta.icon}
                    />
                    <h3 class="text-sm font-bold text-chocolate">
                      {tarjeta.text}
                    </h3>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      ))
    }

    {
      pagina.closing.map((parrafo) => (
        <p class="text-lg" set:html={negritas(parrafo)} />
      ))
    }

    <a
      href="/"
      class="inline-block border-b border-mustard pb-1 text-xs font-bold uppercase tracking-widest text-mustard transition-colors hover:text-vibrant-orange"
    >
      Volver al inicio
    </a>
  </section>
</Layout>
