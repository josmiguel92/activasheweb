---
import { CollectionEntry, getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import formatDate from "@/utils/formatDate";
import { fechaISO } from "@/utils/formatDate";
import { publicadas } from "@/utils/contenido";
import { descripcionSeo } from "@/utils/resumen";
import readingTime from "@/utils/readingTime";
import PostCard from "@/components/PostCard.astro";
import { proyectoDePublicacion } from "@/utils/series";

export async function getStaticPaths() {
  const posts = publicadas(await getCollection("posts"));

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const { Content } = await post.render();
const minutes = readingTime(post.body);

// Proyecto del que forma parte el artículo, si lo declara; ver
// src/utils/series.ts.
const proyecto = proyectoDePublicacion(post, await getCollection("projects"));

// Para seguir leyendo, primero los artículos del mismo proyecto: son la
// continuación natural. Si no llegan a dos, se completa con los más
// recientes del resto.
const resto = publicadas(await getCollection("posts")).filter(
  (p) => p.slug !== post.slug,
);
const related = [
  ...resto.filter((p) => proyecto && p.data.project === proyecto.slug),
  ...resto.filter((p) => !proyecto || p.data.project !== proyecto.slug),
].slice(0, 2);
---

<Layout
  title={post.data.title}
  description={descripcionSeo(post.data.description, post.body)}
  image={post.data.image}
  imageAlt={post.data.title}
  type="article"
  publishedAt={post.data.publishedAt}
  section="Publicaciones"
>
  <article class="mx-auto max-w-4xl px-6">
    <Breadcrumbs
      items={[
        { label: "Publicaciones", href: "/posts" },
        { label: post.data.title },
      ]}
      textColor="text-chocolate"
      mutedColor="text-chocolate/70"
      separatorColor="text-chocolate/30"
    />
    <header class="card-shadow mb-8 rounded-3xl bg-terracotta-deep p-8">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
        <span
          class="text-[11px] font-black uppercase tracking-widest text-warm-cream/90"
          >Artículo</span
        >
        <span class="text-sm text-warm-cream/90">
          <time datetime={fechaISO(post.data.publishedAt)}
            >{formatDate(post.data.publishedAt)}</time
          >
          <span aria-hidden="true"> · </span>{minutes} min de lectura
        </span>
      </div>
      <h1 class="mb-4 font-display text-4xl leading-tight text-warm-cream">
        {post.data.title}
      </h1>
      <p class="text-lg italic text-warm-cream/90">{post.data.description}</p>
      {
        proyecto && (
          <p class="mt-5 border-t border-warm-cream/20 pt-4 text-sm text-warm-cream/90">
            <span class="material-symbols-outlined align-middle text-base" aria-hidden="true">
              folder_open
            </span>{" "}
            Forma parte del proyecto{" "}
            <a
              href={`/projects/${proyecto.slug}`}
              class="font-bold text-warm-cream underline decoration-mustard decoration-2 underline-offset-4 hover:decoration-warm-cream"
            >
              {proyecto.data.title}
            </a>
          </p>
        )
      }
    </header>

    {
      post.data.image && (
        <div class="mb-8 flex w-full justify-center overflow-hidden rounded-3xl bg-white/5">
          <img
            src={post.data.image}
            alt={post.data.title}
            class="w-full max-h-80 object-contain md:max-h-[26rem]"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )
    }

    <div class="post prose prose-lg mx-auto mb-8 max-w-3xl text-chocolate">
      <Content />
    </div>

    <div class="mb-8 rounded-2xl border border-white/10 bg-white/5 p-6">
      <ShareButtons
        url={`/posts/${post.slug}`}
        title={post.data.title}
        description={post.data.description}
      />
    </div>

    {
      related.length > 0 && (
        <section aria-labelledby="seguir-leyendo" class="mt-12">
          <h2 id="seguir-leyendo" class="mb-6 font-display text-2xl text-chocolate">
            Seguir leyendo
          </h2>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            {related.map((p) => (
              <PostCard
                publishedAt={p.data.publishedAt}
                title={p.data.title}
                description={p.data.description}
                slug={p.slug}
                image={p.data.image}
                readingTime={readingTime(p.body)}
              />
            ))}
          </div>
        </section>
      )
    }

    <div class="mt-12 border-t border-chocolate/10 pt-8">
      <a
        href="/posts"
        class="inline-flex items-center gap-2 text-sm font-bold text-terracotta-deep transition-all hover:gap-3 hover:text-terracotta"
      >
        <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_back</span>
        Volver a publicaciones
      </a>
    </div>
  </article>
</Layout>
