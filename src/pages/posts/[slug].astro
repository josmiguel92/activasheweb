---
import { CollectionEntry, getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import formatDate from "@/utils/formatDate";
import readingTime from "@/utils/readingTime";
import PostCard from "@/components/PostCard.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const { Content } = await post.render();
const minutes = readingTime(post.body);

const related = (await getCollection("posts"))
  .filter((p) => p.slug !== post.slug && p.data.isPublish)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 2);
---

<Layout
  title={`${post.data.title} | ActivaShe`}
  description={post.data.description}
  image={post.data.image}
  imageAlt={post.data.title}
  type="article"
  publishedAt={post.data.publishedAt}
  section="Publicaciones"
>
  <article class="mx-auto max-w-4xl px-6">
    <Breadcrumbs
      items={[
        { label: "Publicaciones", href: "/posts" },
        { label: post.data.title },
      ]}
      textColor="text-chocolate"
      mutedColor="text-chocolate/60"
      separatorColor="text-chocolate/30"
    />
    <header class="card-shadow mb-8 rounded-3xl bg-terracotta-deep p-8">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-2">
        <span
          class="text-[11px] font-black uppercase tracking-widest text-warm-cream/90"
          >Artículo</span
        >
        <span class="text-sm text-warm-cream/90">
          <time datetime={post.data.publishedAt.toISOString()}
            >{formatDate(post.data.publishedAt)}</time
          >
          <span aria-hidden="true"> · </span>{minutes} min de lectura
        </span>
      </div>
      <h1 class="mb-4 font-display text-4xl leading-tight text-warm-cream">
        {post.data.title}
      </h1>
      <p class="text-lg italic text-warm-cream/90">{post.data.description}</p>
    </header>

    {
      post.data.image && (
        <div class="mb-8 flex w-full justify-center overflow-hidden rounded-3xl bg-white/5">
          <img
            src={post.data.image}
            alt={post.data.title}
            class="w-full max-h-80 object-contain md:max-h-[26rem]"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      )
    }

    <div class="post prose prose-lg mx-auto mb-8 max-w-3xl text-chocolate">
      <Content />
    </div>

    <div class="mb-8 rounded-2xl border border-white/10 bg-white/5 p-6">
      <ShareButtons
        url={`/posts/${post.slug}`}
        title={post.data.title}
        description={post.data.description}
      />
    </div>

    {
      related.length > 0 && (
        <section aria-labelledby="seguir-leyendo" class="mt-12">
          <h2 id="seguir-leyendo" class="mb-6 font-display text-2xl text-chocolate">
            Seguir leyendo
          </h2>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            {related.map((p) => (
              <PostCard
                publishedAt={p.data.publishedAt}
                title={p.data.title}
                description={p.data.description}
                slug={p.slug}
                image={p.data.image}
                readingTime={readingTime(p.body)}
              />
            ))}
          </div>
        </section>
      )
    }

    <div class="mt-12 border-t border-chocolate/10 pt-8">
      <a
        href="/posts"
        class="inline-flex items-center gap-2 text-sm font-bold text-terracotta-deep transition-all hover:gap-3 hover:text-terracotta"
      >
        <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_back</span>
        Volver a publicaciones
      </a>
    </div>
  </article>
</Layout>
