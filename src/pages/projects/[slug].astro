---
import { CollectionEntry, getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ShareButtons from "@/components/ShareButtons.astro";
import formatDate from "@/utils/formatDate";
import { fechaISO } from "@/utils/formatDate";
import { publicadas } from "@/utils/contenido";
import StatusBadge from "@/components/StatusBadge.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Button from "@/components/Button.astro";

export async function getStaticPaths() {
  const projects = publicadas(await getCollection("projects"));

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Props = {
  project: CollectionEntry<"projects">;
};

const { project } = Astro.props;
const { Content } = await project.render();

const others = publicadas(await getCollection("projects"))
  .filter((p) => p.slug !== project.slug)
  .slice(0, 2);
---

<Layout
  title={`${project.data.title} | Proyectos ActivaShe`}
  description={project.data.description}
  image={project.data.image}
  imageAlt={project.data.title}
  type="article"
  publishedAt={project.data.publishedAt}
  section="Proyectos"
  tags={project.data.areas}
>
  <article class="mx-auto max-w-4xl px-6">
    <Breadcrumbs
      items={[
        { label: "Proyectos", href: "/projects" },
        { label: project.data.title },
      ]}
      textColor="text-chocolate"
      mutedColor="text-chocolate/60"
      separatorColor="text-chocolate/30"
    />
    <header
      class="card-shadow mb-8 rounded-3xl bg-gradient-to-br from-olive to-soft-olive p-8"
    >
      <div class="mb-4 flex items-start justify-between">
        <div>
          {
            project.data.areas && project.data.areas.length > 0 && (
              <span class="rounded-full border border-soft-olive/60 bg-soft-olive/60 px-3 py-1 text-[10px] font-black uppercase tracking-widest text-warm-cream backdrop-blur">
                {project.data.areas.join(" • ")}
              </span>
            )
          }
        </div>
        <div class="flex items-center gap-2">
          <StatusBadge
            label={project.data.isComingSoon ? "Próximo" : "Activo"}
            tone={project.data.isComingSoon ? "accent" : "muted"}
          />
          <time
            datetime={fechaISO(project.data.publishedAt)}
            class="text-sm text-warm-cream/90"
            >{formatDate(project.data.publishedAt)}</time
          >
        </div>
      </div>
      <h1 class="mb-4 font-display text-4xl leading-tight text-warm-cream">
        {project.data.title}
      </h1>
      <p class="text-lg italic text-warm-cream/90">
        {project.data.description}
      </p>
    </header>

    <div class="post prose prose-lg mx-auto mb-8 max-w-3xl text-chocolate">
      <Content />
    </div>

    {
      project.data.showDonate && (
        <aside class="mb-8 rounded-2xl border-l-4 border-mustard bg-olive/10 p-6">
          <h2 class="mb-2 font-display text-xl text-chocolate">
            Este proyecto se sostiene con apoyo
          </h2>
          <p class="mb-4 text-chocolate/80">
            Escríbenos y te contamos las vías seguras para que tu aporte llegue
            íntegramente a quienes lo necesitan.
          </p>
          <div class="flex">
            <Button href="/donate" label="Colabora con ActivaShe" icon="heart" />
          </div>
        </aside>
      )
    }

    <div class="mb-8 rounded-2xl border border-soft-olive/30 bg-white/5 p-6">
      <ShareButtons
        url={`/projects/${project.slug}`}
        title={project.data.title}
        description={project.data.description}
      />
    </div>

    {
      others.length > 0 && (
        <section aria-labelledby="otros-proyectos" class="mt-12">
          <h2 id="otros-proyectos" class="mb-6 font-display text-2xl text-chocolate">
            Otros proyectos
          </h2>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            {others.map((p) => (
              <ProjectCard
                title={p.data.title}
                areas={p.data.areas}
                link={`/projects/${p.slug}`}
                isComingSoon={!!p.data.isComingSoon}
                preview={p.data.description}
                image={p.data.image}
              />
            ))}
          </div>
        </section>
      )
    }

    <div class="mt-12 border-t border-soft-olive/30 pt-8">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 text-sm font-bold text-terracotta-deep transition-all hover:gap-3 hover:text-olive"
      >
        <span class="material-symbols-outlined text-sm" aria-hidden="true">arrow_back</span>
        Volver a proyectos
      </a>
    </div>
  </article>
</Layout>
