---
import { getEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import negritas from "@/utils/negritas";

// Los textos se editan desde /admin → «Páginas fijas → Podcasts».
const { data: pagina } = await getEntry("pages", "podcasts");
---

<Layout title={pagina.title} description={pagina.seoDescription}>
  <section
    class="mx-auto flex min-h-[40vh] max-w-4xl flex-col justify-center space-y-6 px-6 lg:max-w-6xl"
  >
    <h1 class="font-display text-4xl text-chocolate">
      {pagina.heading}{
        pagina.headingHighlight && (
          <>
            {" "}
            <span class="text-terracotta">{pagina.headingHighlight}</span>
          </>
        )
      }
    </h1>

    {
      pagina.intro.map((parrafo) => (
        <p class="text-lg text-chocolate/70" set:html={negritas(parrafo)} />
      ))
    }

    {
      pagina.aside && (
        <div class="flex flex-col items-center justify-center rounded-3xl border border-mustard/30 bg-white/5 p-6 text-center text-chocolate/80">
          {pagina.aside.title && (
            <p class="text-lg font-bold text-terracotta-deep">
              {pagina.aside.title}
            </p>
          )}
          {pagina.aside.text && (
            <p class="mt-2 text-sm" set:html={negritas(pagina.aside.text)} />
          )}
        </div>
      )
    }

    {
      pagina.closing.map((parrafo) => (
        <p class="text-lg text-chocolate/70" set:html={negritas(parrafo)} />
      ))
    }
  </section>
</Layout>
