---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollToTop from "@/components/ScrollToTop.astro";
import BlurCircle from "@/components/shared/BlurCircle.astro";
import theme from "@/data/theme";
import SEOTags from "@/components/seo/SEOTags.astro";

import "@/styles/tailwind.css";
import "@/styles/post.css";

export interface Props {
  title?: string;
  description?: string;
  noTopMargin?: boolean;
  bodyClass?: string;
  /** Imagen para la tarjeta social (Open Graph / Twitter). */
  image?: string;
  imageAlt?: string;
  /** "article" para contenidos (posts, proyectos, obras). */
  type?: "website" | "article";
  publishedAt?: Date;
  section?: string;
  tags?: string[];
}

const {
  title,
  description,
  noTopMargin = false,
  bodyClass = "bg-warm-cream",
  image,
  imageAlt,
  type,
  publishedAt,
  section,
  tags,
} = Astro.props as Props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <SEOTags
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      publishedAt={publishedAt}
      section={section}
      tags={tags}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,700;9..144,800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-4B1E6QKQQC"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-4B1E6QKQQC");
    </script>
  </head>

  <body class:list={["min-h-screen text-chocolate", bodyClass]}>
    <a
      href="#contenido"
      class="sr-only z-[60] rounded-xl bg-mustard px-4 py-2 font-bold text-chocolate focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Saltar al contenido
    </a>
    <Header />
    <main
      id="contenido"
      tabindex="-1"
      class:list={[!noTopMargin && "mt-8", "space-y-16 pb-20 outline-none"]}
    >
      <slot />
    </main>
    <Footer />
    <ScrollToTop />
    <BlurCircle position="top" color={theme.colors.blur.top} />
    <BlurCircle position="bottom" color={theme.colors.blur.bottom} />
  </body>
</html>
